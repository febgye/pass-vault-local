<Application
    x:Class="LiquidVault.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="VaultBackgroundColor">#FF070A12</Color>

            <LinearGradientBrush
                x:Key="VaultBackgroundBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#FF05070F" Offset="0" />
                <GradientStop Color="#FF0B1220" Offset="0.45" />
                <GradientStop Color="#FF0A1020" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush
                x:Key="VaultCardBrush"
                StartPoint="0,0"
                EndPoint="1,1">
                <GradientStop Color="#1CFFFFFF" Offset="0" />
                <GradientStop Color="#0DFFFFFF" Offset="0.42" />
                <GradientStop Color="#06FFFFFF" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="VaultAccentBrush" Color="#FF7DD3FC" />
            <SolidColorBrush x:Key="VaultLineBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="VaultLineStrongBrush" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="VaultTextBrush" Color="#EBFFFFFF" />
            <SolidColorBrush x:Key="VaultInputBrush" Color="#38000000" />

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Foreground" Value="{StaticResource VaultTextBrush}" />
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource VaultLineStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Foreground" Value="{StaticResource VaultTextBrush}" />
                <Setter Property="Background" Value="{StaticResource VaultInputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource VaultLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Foreground" Value="{StaticResource VaultTextBrush}" />
                <Setter Property="Background" Value="{StaticResource VaultInputBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource VaultLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
